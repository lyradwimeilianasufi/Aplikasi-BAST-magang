<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fontFamily="@font/barlow_semi_condensed"
    tools:context=".DetailKehadiranIzinActivity">

    <!-- Header / Toolbar Wrapper -->
    <LinearLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Konten Toolbar Utama -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="60dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:padding="12dp"
                android:src="@drawable/ic_back_white"
                app:tint="@color/black" />

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@id/btnBack"
                android:fontFamily="@font/barlow_semi_condensed"
                android:text="Detail Kehadiran"
                android:textColor="@color/black"
                android:textSize="18sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_alignParentBottom="true"
                android:background="#E0E0E0" />
        </RelativeLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Work Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="12dp">

                    <androidx.constraintlayout.widget.Guideline
                        android:id="@+id/guideline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintGuide_percent="0.45" />

                    <!-- Tanggal Kerja Section -->
                    <ImageView
                        android:id="@+id/ivCalendar"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_material_symbols_date_range"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="#4A148C" />

                    <TextView
                        android:id="@+id/labelTanggal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/barlow_semi_condensed"
                        android:text="Tanggal Kerja"
                        android:textColor="#BDBDBD"
                        android:textSize="10sp"
                        app:layout_constraintEnd_toStartOf="@id/guideline"
                        app:layout_constraintStart_toEndOf="@id/ivCalendar"
                        app:layout_constraintTop_toTopOf="@id/ivCalendar" />

                    <TextView
                        android:id="@+id/tvTanggalKerja"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semi_condensed"
                        android:text="Jumat, 03 Jan 2025"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@id/guideline"
                        app:layout_constraintStart_toStartOf="@id/labelTanggal"
                        app:layout_constraintTop_toBottomOf="@id/labelTanggal" />

                    <!-- Jam Kerja Section -->
                    <ImageView
                        android:id="@+id/ivClock"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_mingcute_time_line"
                        app:layout_constraintStart_toEndOf="@id/guideline"
                        app:layout_constraintTop_toTopOf="@id/ivCalendar"
                        app:tint="#4A148C" />

                    <TextView
                        android:id="@+id/labelJam"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/barlow_semi_condensed"
                        android:text="Jam Kerja"
                        android:textColor="#BDBDBD"
                        android:textSize="10sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivClock"
                        app:layout_constraintTop_toTopOf="@id/labelTanggal" />

                    <TextView
                        android:id="@+id/tvJamKerja"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semi_condensed"
                        android:text="Reguler (09:00 - 17:00)"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@id/labelJam"
                        app:layout_constraintTop_toTopOf="@id/tvTanggalKerja" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Summary Section -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semi_condensed"
                        android:text="Total Jam Kerja : "
                        android:textColor="#424242"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvTotalJamKerja"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/barlow_semi_condensed"
                        android:text="-"
                        android:textColor="@color/black"
                        android:textStyle="bold"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pill"
                    android:backgroundTint="#F39C12"
                    android:fontFamily="@font/barlow_semi_condensed"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="4dp"
                    android:text="Izin"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Garis Abu-abu di bawah Total Jam Kerja -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:background="#E0E0E0" />

            <!-- Link Lihat Detail Izin -->
            <TextView
                android:id="@+id/btnLihatDetailIzin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:fontFamily="@font/barlow_semi_condensed"
                android:gravity="center_vertical"
                android:text="Lihat Detail Izin"
                android:textColor="#F39C12"
                android:textSize="14sp"
                android:textStyle="bold"
                app:drawableEndCompat="@drawable/ic_chevron_right"
                app:drawableTint="#F39C12" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
